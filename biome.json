{
  "linter": {
    "enabled": true,
    "includes": [
      "**",
      "!.fastembed_cache/**",
      "!examples/static-solidjs/ui/dist/**"
    ],
    "rules": {
      "recommended": true,
      "style": {
        "noNamespace": "off",
        "useConst": "error",
        "useTemplate": "error"
      },
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "complexity": {
        "noForEach": "off",
        "noBannedTypes": "off",
        "useLiteralKeys": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "formatter": {
    "enabled": false
  }
}
