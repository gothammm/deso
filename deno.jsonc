{
  "name": "@deso/core",
  "version": "0.12.1",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "exclude": [".fastembed_cache"]
  },
  "lock": false,
  "tasks": {
    "test": "deno test --allow-net --allow-read",
    "check": "deno fmt --check && deno lint && deno task test",
    "bench": "deno run --allow-hrtime benchmarks.ts"
  },
  "fmt": {
    "exclude": ["examples/static-solidjs/ui", ".fastembed_cache"]
  },
  "lint": {
    "exclude": ["examples/static-solidjs/ui", ".fastembed_cache"]
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/http": "jsr:@std/http@^1.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "zod": "npm:zod@^3.24.0",
    "zod-to-json-schema": "npm:zod-to-json-schema@^3.24.0"
  }
}
